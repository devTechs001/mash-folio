{
  "name": "mash-folio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio of Mash \u2014 React + Vite frontend with a Node/Express backend.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "api": "node server/index.js",
    "preview": "npm run build && node server/index.js",
    "test": "node --test server/test/*.test.js",
    "auth:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
