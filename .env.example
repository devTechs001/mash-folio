# Owner-only admin access.
# 1. Pick an email and a strong password.
# 2. Generate the SHA-256 hash of the password:
#      npm run auth:hash -- "your-password"
# 3. Copy this file to .env.local and paste the hash below.
# 4. Restart the dev server (env vars are read at build/start time).
#
# NOTE: Vite exposes VITE_* variables in the client bundle. This gate keeps the
# dashboard out of casual reach, but it is not a substitute for real server-side
# auth (see README → Admin dashboard).

VITE_ADMIN_EMAIL=you@example.com
VITE_ADMIN_PASSWORD_HASH=<sha256-hex-of-your-password>
VITE_ADMIN_SESSION_HOURS=8
