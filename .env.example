# Owner access for the Express API.
# 1. Copy this file to .env.local
# 2. Generate the SHA-256 hash of your password:
#      npm run auth:hash -- "your-password"
# 3. Paste the digest below and restart the server (npm run dev / npm start).
#
# Secrets are read by server/index.js only — they are never bundled into the
# browser bundle. Use the same values in Render (or your host) for production.

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=<sha256-hex-of-your-password>
ADMIN_SESSION_HOURS=8

# Optional
PORT=4000
# DATA_DIR=/var/data        # where content.json + messages.json are stored
# VITE_API_URL=             # only if the API lives on another origin
